<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginVertical="3dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/surface_muted"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/nameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="96dp"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/exitedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_action_chip"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:text="@string/status_exited"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/takenText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/returnedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/profitText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="56dp"
                android:gravity="end"
                android:textAppearance="?attr/textAppearanceTitleMedium" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cashOutButton"
                style="@style/Widget.ChipTrack.Button.CompactTonal"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/action_cash_out"
                android:textColor="@color/btn_add_points"
                android:textSize="12sp"
                app:backgroundTint="@color/btn_add_points_container" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buyInButton"
                style="@style/Widget.ChipTrack.Button.CompactTonal"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/action_buy_in"
                android:textColor="@color/btn_remove_points"
                android:textSize="12sp"
                app:backgroundTint="@color/btn_remove_points_container" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exitButton"
                style="@style/Widget.ChipTrack.Button.CompactOutlined"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:text="@string/action_exit"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/historyButton"
                style="@style/Widget.ChipTrack.Button.CompactText"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/action_player_history"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
