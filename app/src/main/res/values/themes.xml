<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 英文/数字：Monaco；中文：华文楷体（运行时 CustomFallback） -->
    <style name="TextAppearance.ChipTrack" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/monaco</item>
        <item name="android:fontFamily">@font/monaco</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.ChipTrack.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/monaco</item>
        <item name="android:fontFamily">@font/monaco</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.ChipTrack.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/monaco</item>
        <item name="android:fontFamily">@font/monaco</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.ChipTrack.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/monaco</item>
        <item name="android:fontFamily">@font/monaco</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="TextAppearance.ChipTrack.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/monaco</item>
        <item name="android:fontFamily">@font/monaco</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.ChipTrack.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/monaco</item>
        <item name="android:fontFamily">@font/monaco</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.ChipTrack.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/monaco</item>
        <item name="android:fontFamily">@font/monaco</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.ChipTrack.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/monaco</item>
        <item name="android:fontFamily">@font/monaco</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.ChipTrack.Button" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/monaco</item>
        <item name="fontFamily">@font/monaco</item>
    </style>

    <style name="Widget.ChipTrack.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.ChipTrack.TitleLarge</item>
    </style>

    <style name="Theme.ChipTrack" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/sky_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryDark">@color/mist</item>
        <item name="colorSecondary">@color/sky_blue</item>
        <item name="colorOnSecondary">@color/mist</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="android:statusBarColor">@color/mist</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/mist</item>
        <item name="android:windowBackground">@drawable/bg_app</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorBackground">@color/mist</item>

        <item name="android:fontFamily">@font/monaco</item>
        <item name="fontFamily">@font/monaco</item>

        <item name="textAppearanceBodyLarge">@style/TextAppearance.ChipTrack.Body</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.ChipTrack.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.ChipTrack.BodySmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.ChipTrack.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.ChipTrack.Title</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.ChipTrack.Title</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.ChipTrack.Headline</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.ChipTrack.Headline</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.ChipTrack.Label</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.ChipTrack.Label</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.ChipTrack.Label</item>

        <item name="materialButtonStyle">@style/Widget.ChipTrack.Button</item>
        <item name="toolbarStyle">@style/Widget.ChipTrack.Toolbar</item>
    </style>
