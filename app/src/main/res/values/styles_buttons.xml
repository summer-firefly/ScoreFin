<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 底栏三按钮统一尺寸，避免 Tonal/Outlined 混用导致高低不一致 -->
    <style name="Widget.ChipTrack.Button.PresetAction" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">13sp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/monaco</item>
        <item name="fontFamily">@font/monaco</item>
        <item name="strokeColor">@color/sky_blue</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/ink</item>
    </style>
</resources>
